# Database (Postgres — Neon, Supabase, Railway, or local Postgres)
# When omitted in local development, the app automatically uses a persistent local PGlite Postgres database in .data/pglite
DATABASE_URL="postgresql://user:password@localhost:5432/lil_sbd"

# Better Auth Configuration
BETTER_AUTH_SECRET="replace-with-a-random-32-char-secret-key"
BETTER_AUTH_URL="http://localhost:3000"

# Multi-Producer Access Control
# If ADMIN_EMAIL is set and PUBLIC_SIGNUP_ENABLED is "false", only ADMIN_EMAIL can register.
# Flip PUBLIC_SIGNUP_ENABLED="true" when you are ready to open registration to other producers!
ADMIN_EMAIL=""
PUBLIC_SIGNUP_ENABLED="true"

# Optional Social OAuth Providers (GitHub / Discord)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Optional PostHog Analytics
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"
