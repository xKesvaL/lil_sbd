# Database (Postgres — Neon, Supabase, Railway, or Coolify Postgres)
# When omitted in local development, the app automatically uses a persistent local PGlite Postgres database in .data/pglite
DATABASE_URL="postgresql://user:password@localhost:5432/lil_sbd"

# Persistent Data & Media Directory (mount as a Docker volume in Coolify, e.g. /app/.data)
SOCIAL_DATA_DIR=".data"

# Better Auth & Public URL Configuration
BETTER_AUTH_SECRET="replace-with-a-random-32-char-secret-key"
BETTER_AUTH_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# Multi-Producer Access Control
# If ADMIN_EMAIL is set and PUBLIC_SIGNUP_ENABLED is "false", only ADMIN_EMAIL can register.
# Flip PUBLIC_SIGNUP_ENABLED="true" when you are ready to open registration to other producers!
ADMIN_EMAIL=""
PUBLIC_SIGNUP_ENABLED="true"

# Gemini AI Director & Copywriter (Free tier friendly — configurable model)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional Object Storage (Cloudflare R2 / Hetzner Object Storage / S3)
# Leave blank to use the local Hetzner NVMe volume (zero extra setup).
# Set these 5 values to automatically store permanent renders & demo masters on R2/S3 (10 GB free on R2, $0 egress).
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Optional Direct Native Social Publishing OAuth Credentials
# (You can also paste access tokens directly in /admin/socials -> Tracks & Accounts without setting these)
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Social OAuth Providers (GitHub / Discord)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Optional PostHog Analytics
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"
